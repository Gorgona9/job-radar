# Copy this file to .env and fill in what you have. Everything except the Telegram pair is optional.

# Claude API key — https://console.anthropic.com  (without it the radar falls back to keyword rules)
ANTHROPIC_API_KEY=

# Telegram: create a bot with @BotFather, then message it once and run `npm run test:telegram`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Adzuna (free): https://developer.adzuna.com — leave empty to skip this source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LinkedIn job-alert emails via Gmail IMAP. Use a Gmail *app password* (needs 2-step verification on).
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
